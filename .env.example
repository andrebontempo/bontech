# ============================================================================
# BONTECH — Configurações de Ambiente (.env)
# ============================================================================

# Servidor & Banco de Dados PostgreSQL
FLASK_ENV=production
PORT=80
APP_PORT=5015
SECRET_KEY=bontech_chave_super_secreta_corporativa_2026
POSTGRES_USER=bontech
POSTGRES_PASSWORD=bontech_secret_2026
POSTGRES_DB=bontech
DATABASE_URL=postgresql://bontech:bontech_secret_2026@db:5432/bontech

# URL Base da Aplicação
BASE_URL=https://bontech.com.br

# Google OAuth 2.0 (Login Social)
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_CALLBACK_URL=https://bontech.com.br/auth/google/callback

# E-mail SMTP (Hostinger / Corporativo)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=suporte@bontech.com.br
SMTP_PASS=sua_senha_do_email
SMTP_FROM_NAME="Bontech TI & Governança"
ADMIN_ALERT_EMAIL=suporte@bontech.com.br

# Integração opcional Webhook n8n
N8N_WEBHOOK_URL=

# Administrador Inicial (usado no Seed automático)
ADMIN_NAME="André Bontempo"
ADMIN_EMAIL=suporte@bontech.com.br
ADMIN_PASSWORD=Bontech@2026

# Modo de Manutenção Forçado via Ambiente (opcional)
MAINTENANCE_MODE=false
